# Add these in Dokploy Application > Environment, not to a public Git repository.
ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
SHOPIFY_CLIENT_SECRET=REPLACE_WITH_SHOPIFY_WEBHOOK_SIGNING_SECRET
SHOP_DOMAIN=your-shop.myshopify.com
OVERLAY_KEY=REPLACE_WITH_A_LONG_RANDOM_OVERLAY_KEY
SESSION_KEY=REPLACE_WITH_A_LONG_RANDOM_SESSION_KEY
# Optional: use RIP- to only include Shopify line items where SKU starts with RIP-
RIP_SKU_PREFIX=
